{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Magic Explore",
  "version": "1.0.0",
  "identifier": "com.magicexplore.launcher",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Magic Explore",
        "url": "index.html",
        "width": 680,
        "height": 64,
        "center": true,
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "shadow": false
      },
      {
        "label": "backdrop",
        "title": "Magic Explore Backdrop",
        "url": "backdrop.html",
        "width": 1920,
        "height": 1080,
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "focusable": false,
        "visible": false,
        "shadow": false
      },
      {
        "label": "admin-toast",
        "title": "Magic Explore Aviso",
        "url": "toast.html",
        "width": 440,
        "height": 54,
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "focusable": false,
        "visible": false,
        "shadow": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Magic Explore",
    "shortDescription": "Barra de busca flutuante estilo Apple Spotlight para Windows",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "installerHooks": "installer.nsh",
        "languages": ["PortugueseBR", "English"],
        "installMode": "currentUser"
      }
    }
  }
}
